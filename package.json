    "test:data": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "build": "npm run data:build && npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
