{
  "name": "names-that-must-not-be-named",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "data:build": "python3 tools/build_data.py",
    "predev": "npm run data:build",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
